# ── MasterMind — Local only (no cloud) ─────────────────────────────────────
DIRECT_MODE=1
# ── Local model ──────────────────────────────────────────────────────────
MODEL_PATH=C:\Users\dario\.cache\eve\Qwen3.5-4B.Q4_K_M.gguf
# ── Context ─────────────────────────────────────────────────────────────────
CONTEXT_SIZE=16384
MAX_TOKENS=2048
# ── Sampling ────────────────────────────────────────────────────────────────
TEMPERATURE=1.0
TOP_K=64
TOP_P=0.95
MIN_P=0.0
REPEAT_PENALTY=1.0
# ── Agent ───────────────────────────────────────────────────────────────────
MAX_TURNS=50
PERMISSION_MODE=auto
WORKING_DIR=.
VERBOSE=0
# ── GPU settings (RTX 3090 24GB) ────────────────────────────────────────────
N_GPU_LAYERS=-1
N_THREADS=0
N_THREADS_BATCH=0
BATCH_SIZE=2048
FLASH_ATTN=1
KV_CACHE_TYPE=q8_0
USE_MLOCK=0
# ── Voice I/O ───────────────────────────────────────────────────────────────
TTS_BACKEND=kokoro
TTS_VOICE=af_heart
TTS_SPEED=1.0
EDGE_TTS_VOICE=en-GB-SoniaNeural
# ── Whisper STT ─────────────────────────────────────────────────────────────
WHISPER_MODEL=base
VAD_SILENCE_MS=700
VAD_THRESHOLD=0.01
# ── Vector embeddings ───────────────────────────────────────────────────────
EMBED_BACKEND=sentence_transformers
EMBED_MODEL=all-MiniLM-L6-v2
# ── Kairos / AutoDream ──────────────────────────────────────────────────────
KAIROS_TICK_S=300
AUTODREAM_IDLE_S=120
# ── WhatsApp owner (optional) ────────────────────────────────────────────── 
OWNER_WA_NUMBER=447447148024